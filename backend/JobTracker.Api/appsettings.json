{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost;Database=JobTracker_DB;Trusted_Connection=True;TrustServerCertificate=True;"
    },
    "Jwt": {
        "Secret": "ReplaceThisWithAStrong256BitOrGreaterSecretKeyForProduction12345!",
        "Issuer": "JobTrackerApi",
        "Audience": "JobTrackerClient",
        "ExpiryMinutes": 15,
        "RefreshTokenExpiryDays": 7
    },
    "Matching": {
        "Provider": "Gemini",
        "ModelName": "gemini-1.5-flash",
        "RequestTimeoutSeconds": 30,
        "MaxInputLength": 8000
    }
}